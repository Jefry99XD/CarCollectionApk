rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // TAGS
    match /tags/{tagId} {
      allow read: if true;              // públicos
      allow write: if request.auth != null;
    }

    // ACHIEVEMENTS GLOBAL
    match /achievements/{achievementId} {
      allow read: if true;              // públicos
      allow write: if request.auth != null;
    }

    // USERS
    match /users/{userId} {

      // El perfil público debe permitir lectura
      allow read: if request.auth != null;

      // Permitir crear su propio perfil durante el registro
      allow create: if request.auth != null && request.auth.uid == userId;

      // El dueño puede actualizar su perfil
      allow update, delete: if request.auth != null && request.auth.uid == userId;

      // --- Autos visibles para todos los usuarios autenticados (colección principal) ---
      match /cars/{carId} {
        allow read: if request.auth != null; // TODOS pueden verlo
        allow write, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // --- Autos visibles para todos los usuarios autenticados (colección alternativa) ---
      match /carsCollection/{carId} {
        allow read: if request.auth != null; // TODOS pueden verlo
        allow write, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // --- Tags del usuario ---
      match /tags/{tagId} {
        allow read: if request.auth != null;
        allow write, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // --- Amigos ---
      match /friends/{friendId} {
        allow read: if request.auth != null;
        allow write, delete: if request.auth != null && request.auth.uid == userId;
      }

      // --- Comentarios en el perfil ---
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;        // cualquier usuario autenticado puede comentar
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // --- Actividad ---
      match /activity/{activityId} {
        allow read: if request.auth != null;
        allow write, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // --- Logros del usuario ---
      match /achievements/{achievementId} {
        allow read: if request.auth != null;
        allow write, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // --- Lista de deseados del usuario ---
      match /wishlist/{wishlistId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // --- Notificaciones del usuario ---
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write, update, delete: if request.auth != null && request.auth.uid == userId;
      }

    }

  }
}

